# BindCraft2 (BC2, https://github.com/PacesaLab/BindCraft2) is architecturally very different from
# BindCraft1: no conda, no PyRosetta, no AlphaFold-multimer JAX params baked from ColabDesign. It is
# a plain pip package whose jax[cuda12]/jax[cuda13] extra bundles its own CUDA and cuDNN, so the base
# image only needs an NVIDIA driver on the host (via --nv) and no CUDA toolkit image at all.
Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive
    export PIP_NO_CACHE_DIR=1
    export PYTHONUNBUFFERED=1

    apt-get -q update
    apt-get install --no-install-recommends -y \
        git \
        python3 \
        python3-venv \
        python3-pip \
        python3-dev \
        build-essential \
        ca-certificates

    # create and activate virtual environment
    python3 -m venv /opt/venv
    . /opt/venv/bin/activate
    pip install --upgrade pip

    # Clone BindCraft2 and check out the pinned revision
    git clone https://github.com/PacesaLab/BindCraft2 /opt/bindcraft2
    cd /opt/bindcraft2 && git checkout 301efdd

    # Editable install: settings/ and scaffolds/ live at the repo root, not inside the package, and
    # the runtime finds them relative to it, so the source tree has to stay in place on disk.
    # Swap cuda12 for cuda13 below if the host driver reports CUDA >= 13 (nvidia-smi) and every GPU
    # is compute capability 7.5 or newer; see install.sh in the repo for the detection logic.
    pip install -e "/opt/bindcraft2[cuda12]"

    # jax's cuda wheels keep their libraries under site-packages/nvidia/*/lib, off the loader's
    # default path, so this discovers and registers them the same way the upstream Dockerfile does.
    python3 -c "import nvidia, pathlib; print('\n'.join(sorted(str(path) for root in nvidia.__path__ for path in pathlib.Path(root).glob('*/lib'))))" > /etc/ld.so.conf.d/bindcraft2-cuda.conf
    ldconfig

    # link venv
    echo '. /opt/venv/bin/activate' >> "$APPTAINER_ENVIRONMENT"

    # cleanup
    rm -rf /var/lib/apt/lists/*
    apt-get autoremove -y
    apt-get clean

%environment
    export NVIDIA_VISIBLE_DEVICES=all
    export NVIDIA_DRIVER_CAPABILITIES=compute,utility
    # HOME is read-only under apptainer by default; matplotlib needs somewhere writable to cache
    export MPLCONFIGDIR=/tmp

%runscript
    exec bindcraft "$@"

%test
    . /opt/venv/bin/activate
    cd /opt/bindcraft2
    python3 -c "import jax, bindcraft.proteinmpnn; print('jax', jax.__version__)"
    bindcraft --help > /dev/null
    python3 -m bindcraft.selfcheck cuda12 --shipped-only
    echo "Build tests completed sucessfully"

%labels
    Author JoshuaHardy
    Version 3.1
    Description "Apptainer container for BindCraft2 (BC2) protein binder design"

%help
    BindCraft2 (https://github.com/PacesaLab/BindCraft2) container for protein binder design.
    ProteinMPNN weights ship inside the package. AlphaFold uses the same parameter archive as the
    rest of this repo (alphafold_params_2022-12-06.tar) and the same params_model_*.npz layout, so
    point BINDCRAFT_AF2_PARAMS at the existing models/af2/ directory from scripts/download_models.sh
    instead of letting BC2 fetch its own separate 5.3 GB copy.

    Execute with GPU support using:
        apptainer run --nv bindcraft2.sif design settings.json

    Run reusing the shared AF2 params, with settings/output on the host:
        apptainer run --nv \
            --bind /path/to/models/af2:/af2-params:ro \
            --bind "$PWD:/work" --pwd /work \
            --env BINDCRAFT_AF2_PARAMS=/af2-params \
            bindcraft2.sif design settings.json

    Without BINDCRAFT_AF2_PARAMS, BC2 downloads its own copy to BINDCRAFT_WEIGHTS (default
    ~/.cache/bindcraft) on first use; pre-fetch it once with:
        apptainer exec --nv --env BINDCRAFT_WEIGHTS=/path/to/cache bindcraft2.sif bindcraft fetch-weights

    Sanity-check that the GPU is actually reached (should print one CudaDevice per card, not
    CpuDevice):
        apptainer exec --nv bindcraft2.sif python3 -c "import jax; print(jax.devices())"
