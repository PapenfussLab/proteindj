params {
    config_profile_description = 'ProteinDJ Pawsey Setonix HPC profile'
    config_profile_contact     = 'Sarah Beecroft (@SarahBeecroft)'
    config_profile_url         = 'https://support.pawsey.org.au/documentation/display/US/Setonix+User+Guide'

    // Number of GCDs per process
    rfdiffusion_gcds = 1
    alphafold2_gcds  = 1
    boltz_gcds       = 1
    bindcraft_gcds   = 1
    fampnn_gcds      = 1
    mpnn_gcds        = 1
    boltzgen_gcds    = 1

    // Concurrent GPU tasks == number of design batches. 8 == one GPU node.
    gpus = 8

    // CPU-only jobs on 'work'
    cpus       = 16
    memory_cpu = '32.GB'

    // ---- Model / weight locations ----------------------------------------
    // These are bind-mount SOURCES, so they must be directories, not globs.

    // Must contain params_model_*.npz from alphafold_params_2022-12-06.
    // Verify with: ls /scratch/references/alphafold_feb2024/databases/params
    af2_models   = '/scratch/references/alphafold_feb2024/databases/params/alphafold_params_2022-12-06'

    // Must contain boltz2_conf.ckpt, boltz2_aff.ckpt, ccd.pkl, mols/
    boltz_models = '/scratch/references/proteinfold_jun2026/params'

    // TODO: Update to the Pawsey directory containing ProteinMPNN model weights.
    mpnn_models = '/scratch/references/PLACEHOLDER/proteinmpnn'

    // TODO: Update to the Pawsey directory containing BoltzGen checkpoints and mols.zip.
    bg_models = '/scratch/references/PLACEHOLDER/boltzgenmodels'

    // ---- Compilation caches (same layout as the proteinfold profile) ------
    alphafold2_jax_compilation_cache_dir = "${System.getenv('MYSOFTWARE')}/jax_cache/proteindj_af2"
    bindcraft_jax_compilation_cache_dir  = "${System.getenv('MYSOFTWARE')}/jax_cache/proteindj_bindcraft"
}

singularity {
    enabled     = true
    autoMounts  = true
    autoCleanUp = true
    cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getenv('MYSOFTWARE')}/.singularity"
}
apptainer.enabled = false
docker.enabled    = false
conda.enabled     = false

executor {
    queueSize = 1024
}

workDir = "${System.getenv('MYSCRATCH')}/proteindj_work"

process {
    module         = 'singularity/3.11.4-nohost'
    resourceLimits = [ memory: 230.GB, cpus: 64 ]

    executor       = 'slurm'
    clusterOptions = "--account=${System.getenv('PAWSEY_PROJECT')}"
    cache          = 'lenient'
    stageInMode    = 'symlink'
    queue          = { task.memory && task.memory > 230.GB ? 'highmem' : 'work' }

    cpus   = params.cpus
    memory = params.memory_cpu
    time   = { 2.h * task.attempt }

    // nextflow.config sets time = { N.h * task.attempt } but never sets an
    // errorStrategy, so the multiplier never fires. Make retries real.
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247,255] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'RunRFD' {
        // (ProteinDJ uses the PapenfussLab/RFdiffusion fork @ 0938f87).
        container        = 'quay.io/pawsey/rfdiffusion:rocm7.0.0_dgl2.4.0'
        containerOptions = "-B ./schedules:/app/RFdiffusion/schedules -B ${projectDir}/scripts:/scripts"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.rfdiffusion_gcds} --mem=0 --ntasks=${params.rfdiffusion_gcds}"
        time             = { 2.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunAF2' {
        //container        = 'quay.io/pawsey/alphafold2:proteindj'
        container        = '/scratch/pawsey0001/sbeecroft/proteindj/alphafold2_proteindj.sif'
        containerOptions = "-B ${projectDir}/scripts:/scripts --env JAX_COMPILATION_CACHE_DIR=${params.alphafold2_jax_compilation_cache_dir} --bind ${params.af2_models}:/dl_binder_design/af2_initial_guess/model_weights/params --bind ${projectDir}/scripts:/scripts"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.alphafold2_gcds} --mem=0 --ntasks=${params.alphafold2_gcds}"
        time             = { 1.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunBoltz' {
        container        = 'quay.io/pawsey/boltz2:v2.2.1_rocm6.4.1'
        containerOptions = "-B ${projectDir}/scripts:/scripts --bind ${params.boltz_models}:/boltzcache"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.boltz_gcds} --mem=0 --ntasks=${params.boltz_gcds}"
        time             = { 2.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunBC' {
        container        = 'quay.io/pawsey/freebindcraft:v1.0.5_rocm7.0.2_nopyrosetta'
        containerOptions = "-B ${params.af2_models}:/af2params --env JAX_COMPILATION_CACHE_DIR=${params.bindcraft_jax_compilation_cache_dir}"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.bindcraft_gcds} --mem=0 --ntasks=${params.bindcraft_gcds}"
        time             = { 8.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunFAMPNN' {
        //container        = 'quay.io/pawsey/PLACEHOLDER'
        container        = '/scratch/pawsey0001/sbeecroft/proteindj/fampnn_proteindj.sif'
        //containerOptions = "-B ${projectDir}/scripts:/scripts -B ${projectDir} --env TRITON_CACHE_DIR=/tmp/triton_cache --env XDG_CACHE_HOME=/tmp"
        containerOptions = "-B ${projectDir}/scripts:/scripts -B ${projectDir} --env TRITON_CACHE_DIR=/tmp/triton_cache --env XDG_CACHE_HOME=/tmp --env TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.fampnn_gcds} --mem=0 --ntasks=${params.fampnn_gcds}"
        time             = { 2.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunMPNN' {
        // TODO: Build and publish a Pawsey-compatible ProteinMPNN container.
        container        = '/scratch/pawsey0001/sbeecroft/proteindj/mpnn_proteindj.sif'
        containerOptions = "-B ${projectDir}/scripts:/scripts -B ${projectDir} --bind ${params.mpnn_models}:/ProteinMPNN/"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.mpnn_gcds} --mem=0 --ntasks=${params.mpnn_gcds}"
        time             = { 2.h * task.attempt }
        cpus             = 2
        memory           = null
    }

    withName: 'RunBG' {
        // TODO: Build and publish a Pawsey-compatible BoltzGen container.
        container        = '/scratch/pawsey0001/sbeecroft/proteindj/boltzgen_proteindj.sif'
        containerOptions = "-B ${projectDir}/scripts:/scripts -B ${projectDir} --bind ${params.bg_models}:/cache"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.boltzgen_gcds} --mem=0 --ntasks=${params.boltzgen_gcds}"
        time             = { 2.h * task.attempt }
        cpus             = 1
        memory           = null
    }
}
